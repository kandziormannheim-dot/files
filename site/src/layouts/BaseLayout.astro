---
/**
 * BaseLayout — Gerüst jeder Seite.
 *
 * Verantwortlich für: Dokumentkopf, Sprachauszeichnung, hreflang, kanonische
 * URL, Schriftvorabladung und den flackerfreien Start des Themes.
 */
import { content } from "../lib/i18n";
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/global.css";

export interface Props {
  /** Seitentitel ohne Namenszusatz — der wird hier angehängt. */
  title: string;
  description: string;
  /** Sprache dieses Dokuments. */
  lang?: "de" | "en";
  /** Pfad der Entsprechung in der jeweils anderen Sprache, für hreflang. */
  altPath?: string;
  /** Von Suchmaschinen fernhalten (Musterseite, Fehlerseite). */
  noIndex?: boolean;
  /**
   * Namenszusatz anhängen. Die Startseite trägt den Namen bereits im Titel
   * und würde ihn sonst doppelt führen.
   */
  appendName?: boolean;
  /**
   * Person-Schema als JSON-LD einbetten — nur auf den Startseiten. Auf
   * Rechtstexten wäre dieselbe Person noch einmal doppelt ausgezeichnet.
   */
  personSchema?: boolean;
}

const {
  title,
  description,
  lang = "de",
  altPath,
  noIndex = false,
  appendName = true,
  personSchema = false,
} = Astro.props;

const site = Astro.site ?? new URL("https://kandzior.de");
const canonical = new URL(Astro.url.pathname, site);
const alternate = altPath ? new URL(altPath, site) : undefined;
const germanHref = lang === "de" ? canonical : alternate;

const fullTitle = appendName ? `${title} | Martin Kandzior` : title;

const ogImage = new URL("/assets/og.png", site);
const ogLocale = lang === "de" ? "de_DE" : "en_GB";

/**
 * Person-Schema — bewusst schmal. Was hier NICHT steht, ist Absicht: kein
 * Arbeitgeber (worksFor), keine Organisation (memberOf, affiliation), kein
 * Amt. Die Neutralitätsregel aus dem Brief gilt auch für strukturierte
 * Daten, die kein Besucher sieht — Suchmaschinen zeigen sie an.
 */
const person = personSchema
  ? {
      "@context": "https://schema.org",
      "@type": "Person",
      name: "Martin Kandzior",
      url: site.href,
      image: ogImage.href,
      email: "mailto:mail@kandzior.de",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Mannheim",
        addressCountry: "DE",
      },
      homeLocation: {
        "@type": "Place",
        name: "Mannheim",
      },
      knowsAbout:
        lang === "de"
          ? [
              "Logistische Risiken",
              "E-Commerce-Logistik",
              "KI, Robotik und Automatisierung",
              "Wirtschaft und Politik",
              "Industrie 5.0",
            ]
          : [
              "Logistical risk mitigation",
              "E-commerce logistics",
              "AI, robotics and automation",
              "Business and politics",
              "Industry 5.0",
            ],
      sameAs: [
        "https://linkedin.com/in/martin-kandzior",
        "https://x.com/martinkandzior",
        "https://facebook.com/martin.kandzior",
      ],
    }
  : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    {
      /* hreflang nur, wenn eine Entsprechung existiert. Ein Verweis auf eine
         Seite, die es nicht gibt, schadet mehr als er nützt. */
      alternate && (
        <>
          <link
            rel="alternate"
            hreflang={lang === "de" ? "en" : "de"}
            href={alternate.href}
          />
          <link rel="alternate" hreflang={lang} href={canonical.href} />
          <link rel="alternate" hreflang="x-default" href={germanHref!.href} />
        </>
      )
    }

    {
      /* Nur die beiden Dateien vorabladen, die auf jeder Seite sofort
         gebraucht werden. Die -ext-Schnitte holt der Browser selbst, wenn ein
         Zeichen daraus vorkommt. */
    }
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/lato-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* v3 ist dark-first: Die Seite ist unabhängig von der Systemeinstellung dunkel. */}
    <meta name="theme-color" content="#08080f" />

    {/* Vorschau beim Teilen — Messenger, LinkedIn, X. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Martin Kandzior" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />

    {
      person && (
        <script type="application/ld+json" set:html={JSON.stringify(person)} />
      )
    }

    <script is:inline>
      // Läuft VOR dem ersten Rendern. Ohne diesen Block blitzt beim Neuladen
      // im dunklen Theme kurz die helle Fläche auf — der Klassiker, der sich
      // später nicht mehr sauber nachrüsten lässt.
      //
      // Regel: Eine ausdrückliche Wahl gewinnt immer. Nur wer nie umgeschaltet
      // hat, bekommt die Systemvorgabe.
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          if (stored === "dark" || stored === "light") {
            document.documentElement.setAttribute("data-theme", stored);
          }
        } catch (e) {
          // Privater Modus oder gesperrter Speicher: Systemvorgabe greift
          // über die prefers-color-scheme-Abfrage in tokens.css.
        }
      })();
    </script>

    {
      /* Silktide Consent Manager v2.0.1 — Cookie-Banner. Selbst gehostet
         unter /vendor/silktide/ statt über jsDelivr: Die Seite lädt weiterhin
         nichts von Dritten, bevor eine Einwilligung vorliegt, und die
         Datenschutzerklärung braucht keinen CDN-Anbieter zu nennen.

         Die Farb-Variablen zeigen auf die Design-Tokens der Seite (mit den
         Original-Hexwerten der Konfiguration als Rückfallwert) — dadurch
         folgt der Banner auch dem hellen Theme, ohne eigene Pflege.

         Das Skript ist defer geladen; deferred Skripte laufen garantiert vor
         DOMContentLoaded, deshalb darf der Init-Aufruf auf dieses Ereignis
         warten, statt das Rendern zu blockieren. Die Wahl landet im
         localStorage (stcm.hasConsented, stcm.consent.*). */
    }
    <link
      rel="stylesheet"
      id="silktide-consent-manager-css"
      href="/vendor/silktide/consent-manager-2.0.1.min.css"
    />
    <style
      id="silktide-consent-manager-overrides"
      is:inline
      set:html={`#stcm-wrapper {
  --boxShadow: -5px 5px 10px 0px #00000012, 0px 0px 50px 0px #0000001a;
  --fontFamily: var(--font-family-body, Helvetica Neue, Segoe UI, Arial, sans-serif);
  --primaryColor: var(--color-accent, #F967FB);
  --backgroundColor: var(--color-bg-secondary, #111120);
  --textColor: var(--color-text-primary, #f4f4f8);
  --backdropBackgroundColor: var(--color-surface-overlay, #05050999);
  --backdropBackgroundBlur: 4px;
  --iconColor: var(--color-accent, #f967fb);
  --iconBackgroundColor: var(--color-bg-secondary, #111120);
}`}
    />
    <script
      is:inline
      defer
      src="/vendor/silktide/consent-manager-2.0.1.min.js"></script>
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        silktideInit();
        // Die Bibliothek hängt sich als ERSTES Kind in den body. Damit stünde
        // ihr Dialog vor der Sprungmarke in der Tab-Reihenfolge, und sein
        // „Cookie-Einstellungen"-Titel würde zur ersten Überschrift jeder
        // Seite. Beiwerk gehört ans Ende: Inhalt zuerst, Banner danach.
        var stcm = document.getElementById("stcm-wrapper");
        if (stcm) document.body.appendChild(stcm);
      });
      function silktideInit() {
        window.silktideConsentManager.init({
          backdrop: {
            show: true,
          },
          icon: {
            position: "bottomLeft",
          },
          prompt: {
            position: "bottomRight",
          },
          consentTypes: [
            {
              id: "notwendig",
              label: "Notwendig",
              description:
                "<p>Diese Cookies sind für den Betrieb der Website erforderlich und lassen sich nicht abschalten. Sie sorgen unter anderem dafür, dass Ihre Datenschutz-Einstellungen gespeichert werden.</p>",
              required: true,
            },
            {
              id: "statistik",
              label: "Statistik",
              description:
                "<p>Diese Cookies helfen mir zu verstehen, welche Inhalte gelesen werden und wie Sie sich auf der Website bewegen. Die Auswertung erfolgt anonymisiert.</p>",
              required: false,
              gtag: "analytics_storage",
            },
            {
              id: "marketing",
              label: "Marketing",
              description:
                "<p>Diese Cookies werden von mir und meinen Partnern genutzt, um Inhalte auch außerhalb dieser Website auszuspielen und die Wirkung von Kampagnen zu messen.</p>",
              required: false,
              gtag: ["ad_storage", "ad_user_data", "ad_personalization"],
            },
          ],
          text: {
            prompt: {
              description:
                "<p>Diese Website nutzt Cookies. Notwendige Cookies sind für den Betrieb erforderlich – alles Weitere setze ich nur mit Ihrer Einwilligung. Sie können Ihre Auswahl jederzeit ändern.</p>",
              acceptAllButtonText: "Alle akzeptieren",
              acceptAllButtonAccessibleLabel: "Alle Cookies akzeptieren",
              rejectNonEssentialButtonText: "Nur notwendige",
              rejectNonEssentialButtonAccessibleLabel:
                "Alle nicht notwendigen Cookies ablehnen",
              preferencesButtonText: "Einstellungen",
              preferencesButtonAccessibleLabel: "Cookie-Einstellungen öffnen",
            },
            preferences: {
              title: "Cookie-Einstellungen",
              description:
                "<p>Sie entscheiden, welche Cookies gesetzt werden. Ihre Auswahl gilt für die gesamte Website und lässt sich jederzeit über das Cookie-Symbol unten links anpassen.</p>",
              saveButtonText: "Auswahl speichern",
              saveButtonAccessibleLabel: "Cookie-Einstellungen speichern",
              creditLinkText: "Kostenloses Cookie-Banner",
              creditLinkAccessibleLabel:
                "Kostenloses Cookie-Banner von Silktide",
            },
          },
        });
      }
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{content(lang).a11y.skipLink}</a>
    <slot />
  </body>
</html>

---
/**
 * Layout der Rechtstexte.
 *
 * Einspaltig, Kopfzeile ohne Ankernavigation und ohne CTA (Header minimal),
 * Zurück-Link zur Startseite, gleiche Fußzeile wie überall. Kein Formular,
 * keine Einbettung — hier wird gelesen, sonst nichts.
 *
 * Die deutsche Fassung ist die rechtlich maßgebliche; englische Seiten
 * übergeben `authoritative` mit dem entsprechenden Hinweis.
 */
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { content, localePath, type Lang } from "../lib/i18n";

export interface Props {
  title: string;
  description: string;
  lang: Lang;
  altPath: string;
  /** Stand des Dokuments, z. B. „August 2026". */
  stand?: string;
}

const { title, description, lang, altPath, stand } = Astro.props;
const c = content(lang);
---

<BaseLayout title={title} description={description} lang={lang} altPath={altPath}>
  <Header lang={lang} minimal />

  <main id="main" class="legal">
    <div class="container legal__container">
      <a class="legal__back" href={localePath("/", lang)}>
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M10.5 3.5 5.5 8l5 4.5" />
        </svg>
        {c.legal.back}
      </a>

      <h1 class="legal__title">{title}</h1>

      {c.legal.authoritative && (
        <p class="legal__authoritative">{c.legal.authoritative}</p>
      )}
      {stand && <p class="legal__stand">{stand}</p>}

      <div class="legal__body prose--relaxed">
        <slot />
      </div>
    </div>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .legal {
    padding-block: var(--space-7) var(--space-9);
  }

  .legal__container {
    max-width: var(--max-width-narrow);
  }

  .legal__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    font-family: var(--font-family-display);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .legal__back svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .legal__title {
    margin-top: var(--space-5);
    font-size: var(--font-size-3xl);
  }

  .legal__authoritative {
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-bg-secondary);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  .legal__stand {
    margin-top: var(--space-3);
    font-size: var(--font-size-sm);
    color: var(--color-text-tertiary);
  }

  .legal__body {
    margin-top: var(--space-6);
  }

  /* Die Gliederung lebt von Überschriften — hier bekommen sie ihren
     Rhythmus, ohne dass jede Seite ihn wiederholen muss. */
  .legal__body :global(h2) {
    margin-top: var(--space-7);
    font-size: var(--font-size-lg);
  }

  .legal__body :global(h3) {
    margin-top: var(--space-5);
    font-size: var(--font-size-md);
  }

  .legal__body :global(p),
  .legal__body :global(ul) {
    margin-top: var(--space-3);
    color: var(--color-text-secondary);
  }

  .legal__body :global(ul) {
    padding-left: 1.2em;
  }

  .legal__body :global(li + li) {
    margin-top: var(--space-2);
  }

  .legal__body :global(address) {
    margin-top: var(--space-3);
    font-style: normal;
    color: var(--color-text-secondary);
  }
</style>

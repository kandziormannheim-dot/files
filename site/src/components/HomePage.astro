---
/**
 * Startseite — gemeinsamer Rumpf für `/` und `/en/`.
 *
 * Beide Sprachrouten sind dünne Hüllen um diese Komponente. Dadurch gibt es
 * genau eine Stelle, an der die Reihenfolge der Bereiche steht.
 *
 * Reihenfolge laut INFORMATION_ARCHITECTURE.md — jede Position beantwortet
 * die nächste Frage im Kopf des Besuchers:
 *   #hero      Wer ist das?           ✔ Aufgabe C1
 *   #proof     Kann der was?          → C2
 *   #expertise Woran arbeitet er?     → C3
 *   #outlook   Wo steht er?           → C4
 *   #about     Wer ist er wirklich?   → C5
 *   #social    Stimmt das auch?       → I2
 *   #events    Wo treffe ich ihn?     → I3 (bedingt)
 *   #contact   Wie erreiche ich ihn?  → I4
 */
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import { type Lang } from "../lib/i18n";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Header lang={lang} />

<main id="main">
  <Hero lang={lang} />
</main>

---
/**
 * Expertise — vier Arbeitsfelder.
 *
 * Die Einleitung ist nicht schmückend, sie ist notwendig: Vier so weit
 * auseinanderliegende Felder nebeneinander lesen sich sonst als „macht
 * alles". Erst der Satz darüber macht daraus „bewegt sich in Räumen, die
 * sich sonst nicht berühren" (Prinzip 2 aus dem Brief).
 *
 * Industrie 5.0 steht bewusst NICHT hier, sondern als eigener Block danach:
 * Das ist eine Haltung, keine Leistung, und beides gehört nicht in dieselbe
 * Kartenreihe.
 */
import { content, type Lang } from "../lib/i18n";
import PillarIcon from "./PillarIcon.astro";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = content(lang).expertise;

/* Trennungs-Entscheid (2026-08-18): Die unternehmerische und die
   politische Sphäre stehen als beschriftete Gruppen getrennt — die
   Politik-Säule bekommt eine eigene Reihe und den violetten Zweitakzent.
   Die Klammer bleibt die Einleitung; die Nummerierung läuft durch. */
const wirtschaft = c.pillars.filter((p) => p.id !== "politics");
const politik = c.pillars.filter((p) => p.id === "politics");
---

<section class="expertise section" id="expertise" aria-labelledby="expertise-heading">
  <div class="container container--wide">
    <div class="expertise__intro">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2 id="expertise-heading" class="expertise__title">{c.title}</h2>
      <p class="expertise__lead">{c.lead}</p>
    </div>

    <p class="expertise__group">{c.groupBusiness}</p>
    <ul class="expertise__grid" role="list">
      {
        wirtschaft.map((pillar, i) => (
          <li class="pillar">
            <div class="pillar__head">
              <span class="pillar__icon">
                <PillarIcon name={pillar.id as "risk" | "ecommerce" | "ai" | "politics"} />
              </span>
              {/* Nummern-Folio: die vier Felder als gezählte Sammlung —
                  Katalog-Anmutung, nicht Aufzählung. */}
              <span class="pillar__num" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
            </div>
            <div class="pillar__text">
              <h3 class="pillar__title">{pillar.title}</h3>
              <p class="pillar__body">{pillar.body}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="expertise__group expertise__group--politics">{c.groupPolitics}</p>
    <ul class="expertise__grid expertise__grid--politics" role="list">
      {
        politik.map((pillar, i) => (
          <li class="pillar pillar--politics">
            <div class="pillar__head">
              <span class="pillar__icon">
                <PillarIcon name={pillar.id as "risk" | "ecommerce" | "ai" | "politics"} />
              </span>
              <span class="pillar__num" aria-hidden="true">
                {String(wirtschaft.length + i + 1).padStart(2, "0")}
              </span>
            </div>
            <div class="pillar__text">
              <h3 class="pillar__title">{pillar.title}</h3>
              <p class="pillar__body">{pillar.body}</p>
              {
                /* Mandats-Zeile (Auftraggeber-Entscheid 2026-08-18, hebt die
                   frühere Nicht-nennen-Vorgabe für die MIT auf): sichtbar auf
                   der Karte, bewusst NICHT im JSON-LD — der Schema-Steckbrief
                   bleibt neutral, polish wacht darüber. */
                "meta" in pillar && (
                  <p class="pillar__mandat">{(pillar as { meta: string }).meta}</p>
                )
              }
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .expertise__intro {
    max-width: var(--max-width-content);
  }

  .expertise__title {
    margin-top: var(--space-3);
    text-wrap: balance;
  }

  .expertise__lead {
    margin-top: var(--space-4);
    color: var(--color-text-secondary);
  }

  /* Gruppenlabel: Mono-Folio mit vorlaufender Linie — Wirtschaft trägt
     die Marke (Pink), Politik den violetten Zweitakzent. Die sichtbare
     Trennung der beiden Sphären ist Absicht, nicht Dekoration. */
  .expertise__group {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-7);
    font-family: var(--font-family-label);
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .expertise__group::before {
    content: "";
    width: var(--space-6);
    height: var(--rule-strong);
    background: var(--color-accent);
  }

  .expertise__group--politics {
    margin-top: var(--space-8);
  }

  .expertise__group--politics::before {
    background: var(--color-accent-second-strong);
  }

  .expertise__grid {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-4) 0 0;
    padding: 0;
  }

  .pillar {
    position: relative;
    display: flex;
    flex-direction: column;
    /* Kein align-items: flex-start hier. Das ließe Titel und Text auf ihre
       Inhaltsbreite schrumpfen statt die Karte zu füllen — gemessen 28 statt
       67 Zeichen pro Zeile. Nur das Icon soll schmal bleiben, und das regelt
       es unten selbst. */
    padding: var(--card-padding);
    background-color: var(--card-bg);
    border: var(--border-width) solid var(--card-border);
    border-radius: var(--card-radius);
    box-shadow: var(--card-shadow);
    /* Die Verlaufs-Oberkante ragt sonst über die Rundung hinaus. */
    overflow: hidden;
    transition:
      transform var(--duration-normal) var(--easing-out),
      box-shadow var(--duration-normal) var(--easing-out),
      border-color var(--duration-normal) var(--easing-out);
  }

  /* Signatur der Sammlung: eine feine Verlaufskante in den Röhrenfarben
     am oberen Rand jeder Karte — ruhig im Grundzustand, kräftiger im Hover. */
  .pillar::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: var(--rule-strong);
    background: var(--gradient-neon);
    opacity: 0.45;
    transition: opacity var(--duration-normal) var(--easing-out);
  }

  .pillar__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .pillar__num {
    font-family: var(--font-family-label);
    font-size: var(--font-size-sm);
    letter-spacing: var(--letter-spacing-wider);
    color: var(--color-text-tertiary);
    transition: color var(--duration-normal) var(--easing-out);
  }

  /* Neon: Die Kante wechselt auf die Marke, die Karte hebt leicht und
     glüht auf; die Icon-Fläche zieht nach. Nur bei Zeigergeräten — auf
     Berührungsgeräten bliebe der Zustand nach dem Tippen hängen. Der Lift
     steht unter Bewegungsreduktion auf 0. */
  @media (hover: hover) {
    .pillar:hover {
      border-color: var(--color-accent);
      box-shadow: var(--card-shadow-hover);
      transform: translateY(var(--lift-card));
    }

    .pillar:hover::before {
      opacity: 1;
    }

    .pillar:hover .pillar__icon {
      background-color: var(--color-accent-quiet);
    }

    .pillar:hover .pillar__num {
      color: var(--color-accent);
    }
  }

  .pillar__icon {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    background: var(--gradient-neon-soft);
    border: var(--border-width) solid var(--color-border-primary);
    color: var(--color-accent);
    transition:
      background-color var(--duration-normal) var(--easing-out),
      border-color var(--duration-normal) var(--easing-out);
  }

  .pillar__title {
    /* Auf der Kartenbreite bricht ein langer Titel sonst unschön in eine
       einzelne Silbe auf der zweiten Zeile. */
    text-wrap: balance;
  }

  .pillar__body {
    margin-top: var(--space-3);
    /* Obergrenze der Zeilenlänge. Ohne sie liefe der Text auf einer breiten
       einspaltigen Karte auf 90 Zeichen und mehr — das Auge findet dann den
       Zeilenanfang nicht mehr zuverlässig wieder. */
    max-width: 62ch;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
  }

  /* Der Rasterbruch folgt der Zeilenlänge, nicht der Bildschirmklasse.
     Gemessen an dieser Schriftgröße braucht eine Karte etwa 500px Breite,
     damit der Text auf ungefähr 50 Zeichen je Zeile kommt. Zwei Spalten
     lohnen sich deshalb erst ab rund 1100px — bei 768px ergäben sie 33
     Zeichen, und ein Absatz wird dann zur Schlagzeilenspalte.

     TASKS.md sah 4 / 2 / 1 vor. Vier nebeneinander ergeben gemessen 28
     Zeichen; das war eine Annahme über das Raster, keine über den Text. */
  @media (min-width: 600px) {
    .expertise__grid {
      gap: var(--space-5);
    }

    /* Einspaltig, aber breit: Das Icon rückt neben den Text, damit die
       Karte nicht als halbleere Fläche dasteht. */
    .pillar {
      flex-direction: row;
      gap: var(--space-5);
    }

    .pillar__icon {
      margin-bottom: 0;
    }
  }

  @media (min-width: 1100px) {
    .expertise__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }

    /* Zurück zur stehenden Karte: In zwei Spalten ist die Breite knapp, und
       das Icon oben lässt dem Text die volle Kartenbreite. */
    .pillar {
      flex-direction: column;
      gap: 0;
    }

    .pillar__icon {
      margin-bottom: var(--space-4);
    }
  }

  /* --- Politik: der violette Zweitakzent trennt die Sphäre sichtbar ------
     Volle Kante in Violett statt des Röhren-Verlaufs, Icon-Fläche und
     Hover ziehen nach. Inhaltlich bleibt die Karte die Brücke — optisch
     steht sie in ihrer eigenen Welt. */
  .pillar--politics::before {
    background: var(--color-accent-second-strong);
    opacity: 0.6;
  }

  .pillar--politics .pillar__icon {
    background: var(--color-accent-second-quiet);
    color: var(--color-accent-second);
  }

  /* Mandats-Zeile: Print-Meta-Register (Haarlinie + Mono) im violetten
     Ton der Sphäre. Keine Versalien — der Eigenname bleibt, wie er ist. */
  .pillar__mandat {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: var(--border-width) solid var(--color-border-primary);
    max-width: 62ch;
    font-family: var(--font-family-label);
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-accent-second);
  }

  @media (hover: hover) {
    .pillar--politics:hover {
      border-color: var(--color-accent-second);
      box-shadow: var(--glow-accent-quiet);
    }

    .pillar--politics:hover .pillar__icon {
      background-color: var(--color-accent-second-quiet);
    }

    .pillar--politics:hover .pillar__num {
      color: var(--color-accent-second);
    }
  }

  /* Die Politik-Karte füllt ihre Reihe allein — liegend, damit die volle
     Breite nicht als halbleere stehende Karte dasteht. Die dritte
     Wirtschafts-Karte spannt aus demselben Grund über beide Spalten:
     drei Karten in zwei Spalten ließen sonst eine leere Zelle. */
  @media (min-width: 1100px) {
    .expertise__grid > li:nth-child(3),
    .expertise__grid--politics .pillar {
      grid-column: 1 / -1;
      flex-direction: row;
      gap: var(--space-5);
    }

    .expertise__grid > li:nth-child(3) .pillar__icon,
    .expertise__grid--politics .pillar__icon {
      margin-bottom: 0;
    }
  }
</style>

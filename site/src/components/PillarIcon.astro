---
/**
 * Icons der vier Expertise-Säulen.
 *
 * Inline-SVG statt Icon-Bibliothek: Für vier Symbole ein Paket zu laden wäre
 * das Vielfache an Gewicht für dasselbe Ergebnis. Alle erben `currentColor`
 * und teilen sich Strichstärke und Raster, damit sie als Satz wirken und
 * nicht als Sammlung.
 */
export interface Props {
  name: "risk" | "ecommerce" | "manda" | "politics";
}

const { name } = Astro.props;
---

<svg
  class="pillar-icon"
  viewBox="0 0 24 24"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {
    /* Absichern: Schild mit Haken. */
    name === "risk" && (
      <>
        <path d="M12 2.75 19.25 5.5v5.4c0 4.4-2.9 8.3-7.25 9.6-4.35-1.3-7.25-5.2-7.25-9.6V5.5L12 2.75Z" />
        <path d="m8.9 11.9 2.2 2.2 4.2-4.4" />
      </>
    )
  }
  {
    /* E-Commerce-Logistik: Paket mit sichtbarer Kante und Deckelnaht. */
    name === "ecommerce" && (
      <>
        <path d="M3.6 7.6 12 3.2l8.4 4.4v8.8L12 20.8l-8.4-4.4V7.6Z" />
        <path d="m3.6 7.6 8.4 4.4 8.4-4.4" />
        <path d="M12 12v8.8" />
        <path d="m7.8 5.4 8.4 4.4" />
      </>
    )
  }
  {
    /* M&A: zwei Stränge, die zusammenlaufen und als einer weitergehen. */
    name === "manda" && (
      <>
        <path d="M6 3.2v3.4c0 2.9 2.3 5.2 5.2 5.2h1.6c2.9 0 5.2-2.3 5.2-5.2V3.2" />
        <path d="M12 11.8v9" />
        <path d="m8.5 17.3 3.5 3.5 3.5-3.5" />
      </>
    )
  }
  {
    /* Wirtschaft & Politik: Giebel auf Säulen — das Bild für öffentliche
       Institutionen, ohne ein bestimmtes Gebäude oder Wappen zu zeigen. */
    name === "politics" && (
      <>
        <path d="M12 3.2 3.4 8h17.2L12 3.2Z" />
        <path d="M5.6 11v7.4M10 11v7.4M14 11v7.4M18.4 11v7.4" />
        <path d="M3.4 20.8h17.2" />
      </>
    )
  }
</svg>

<style>
  .pillar-icon {
    width: 30px;
    height: 30px;
  }
</style>

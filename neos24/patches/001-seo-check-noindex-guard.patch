+# --- indexability (rule 7) -------------------------------------------------
+# A page that ships with a crawler-blocking robots directive can never rank, and
+# the failure is silent: it deploys fine, Google fetches it, and drops it. The
+# judge never sees the <head>, so this is the only layer that can catch it.
+# We look at the generic 'robots' meta plus the per-crawler overrides Google and
+# Bing honour; a directive on ANY of them is enough to lose the page.
+ROBOTS_META_NAMES = frozenset({"robots", "googlebot", "googlebot-news", "bingbot"})
+# 'none' is shorthand for 'noindex, nofollow'. unavailable_after sets an expiry
+# date after which the page is dropped from the index.
+BLOCKING_ROBOTS_DIRECTIVES = ("noindex", "none", "unavailable_after")
+
 

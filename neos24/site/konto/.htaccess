# Kundenportal: alles, was keine Datei ist, an den Front-Controller.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^src/ - [F]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

<FilesMatch "\.(md|sqlite|sqlite-wal|sqlite-shm)$">
  Require all denied
</FilesMatch>
<FilesMatch "^dev-router\.php$">
  Require all denied
</FilesMatch>

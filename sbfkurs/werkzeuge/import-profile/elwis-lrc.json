{
  "_kommentar": "Profil für den ELWIS-Fragenkatalog SRC. Das Textlayout ist nur vermutet — passt ein Muster nicht, hier anpassen, nicht im Skript. Regexe sind PCRE ohne Delimiter (Schrägstriche werden maskiert). modul-/frage-/antwortRegex unterscheiden Groß-/Kleinschreibung; kopfzeilen und bildMarker nicht.",
  "zertifikat": "lrc",
  "quelle": { "name": "Fragenkatalog LRC (ELWIS)", "stand": "", "amtlich": true },
  "kopfzeilen": ["^\\s*Fragenkatalog\\s+LRC.*$", "^\\s*Seite\\s+\\d+(\\s+von\\s+\\d+)?\\s*$", "^\\s*Stand:.*$", "^\\s*-\\s*\\d+\\s*-\\s*$"],
  "modulRegex": "^\\s*(?:Teil|Abschnitt|Modul)?\\s*([A-Z]|\\d{1,2})[.)]?\\s+([A-ZÄÖÜ][A-Za-zÄÖÜäöüß ,/()\\-–]{6,})\\s*$",
  "modulZuordnung": {
    "1": "gmdss", "A": "gmdss",
    "2": "mf-hf", "B": "mf-hf",
    "3": "satellit", "C": "satellit",
    "4": "notverkehr", "D": "notverkehr"
  },
  "module": [
    { "id": "gmdss", "titel": "GMDSS und Seegebiete" },
    { "id": "mf-hf", "titel": "Grenz- und Kurzwelle" },
    { "id": "satellit", "titel": "Satellitenfunk und MSI" },
    { "id": "notverkehr", "titel": "Not-, Dringlichkeits- und Sicherheitsverkehr" }
  ],
  "standardModul": "gmdss",
  "frageRegex": "^\\s*(\\d{1,3})[.)]\\s+(.+)$",
  "antwortRegex": "^\\s*([a-d])[.)]\\s+(.+)$",
  "antwortenOhneKennung": false,
  "richtigIstErste": true,
  "bildMarker": ["siehe Abbildung", "Abb\\.", "Bild", "Skizze"]
}

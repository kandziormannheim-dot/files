# Lokal: docker compose up -d db, dann npm run dev
DATABASE_URL=postgresql://ovtool:ovtool@localhost:5432/ovtool
POSTGRES_PASSWORD=ovtool
AUTH_SECRET=
APP_URL=https://management.cdu-sf.de
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
WHISPER_URL=http://whisper:9000
WHISPER_MODEL=
FILE_STORAGE_PATH=/data/files
ENCRYPTION_KEY=          # für Bürgerkontaktdaten
# Seed (npx prisma db seed): erster Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_FUNCTION=

# PDF: Pfad zu Chromium (im Container /usr/bin/chromium)
CHROMIUM_PATH=

# Produktion (docker compose --profile prod up -d --build)
APP_DOMAIN=management.cdu-sf.de
ACME_EMAIL=                # Kontakt für Let's Encrypt
# Sicherung (scripts/backup.sh)
BACKUP_DIR=/var/backups/ov-tool
BACKUP_AGE_RECIPIENT=      # öffentlicher age-Schlüssel
BACKUP_KEEP_DAYS=30
BACKUP_REMOTE=             # z. B. rclone copy {file} storagebox:ov-backups

# Lokal: docker compose up -d db, dann npm run dev
DATABASE_URL=postgresql://ovtool:ovtool@localhost:5432/ovtool
POSTGRES_PASSWORD=ovtool
AUTH_SECRET=
APP_URL=https://management.cdu-sf.de
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_REPLY_TO=           # z. B. info@cdu-sf.de – Antworten landen dort
# Versand über Brevo (hat Vorrang vor SMTP_*): Brevo → SMTP & API → SMTP-Schlüssel erzeugen.
# Absender dann: CDU Seckenheim-Friedrichsfeld <info@cdu-sf.de> (Domain bei Brevo authentifiziert), änderbar über BREVO_MAIL_FROM
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_MAIL_FROM=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=          # leer = claude-opus-5-5
ANTHROPIC_FALLBACKS=      # "off" schaltet den serverseitigen Rückfall bei Ablehnungen ab
WHISPER_URL=http://whisper:9000
WHISPER_MODEL=
FILE_STORAGE_PATH=/data/files
ENCRYPTION_KEY=          # für Bürgerkontaktdaten
# WordPress-REST (Marketing → Blogartikel). Anwendungspasswort: WP-Admin → Benutzer → Profil → Anwendungspasswörter
WP_SF_URL=https://cdu-sf.de
WP_SF_USER=
WP_SF_APP_PASSWORD=
WP_BBR_URL=https://bbr.cdu-sf.de
WP_BBR_USER=
WP_BBR_APP_PASSWORD=
# Gemeinsamer Login über die Nextcloud (cloud.cdu-sf.de): OAuth-2.0-Client in Nextcloud anlegen,
# Weiterleitungs-URL https://management.cdu-sf.de/api/auth/callback/nextcloud
NEXTCLOUD_URL=https://cloud.cdu-sf.de
NEXTCLOUD_CLIENT_ID=
NEXTCLOUD_CLIENT_SECRET=
# BBR-Anliegen → Social Media: Dienstnutzer mit Lesezugriff auf das Deck-Board (App-Passwort, nur auf dem Server eintragen)
NEXTCLOUD_DECK_USER=
NEXTCLOUD_DECK_APP_PASSWORD=
# Facebook/Instagram direkt veröffentlichen (Meta Graph API): Seiten-ID, Seiten-Token, Instagram-Business-ID je Kanal
META_GRAPH_VERSION=
META_OV_PAGE_ID=
META_OV_PAGE_TOKEN=
META_OV_IG_ID=
META_BBR_PAGE_ID=
META_BBR_PAGE_TOKEN=
META_BBR_IG_ID=
# ffmpeg für Kurzvideos (leer = ffmpeg aus PATH)
FFMPEG_PATH=
# Seed (npx prisma db seed): erster Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_FUNCTION=

# PDF: Pfad zu Chromium (im Container /usr/bin/chromium)
CHROMIUM_PATH=

# Produktion (docker compose up -d --build), siehe docs/betrieb.md
# Zusatzdienste: "prod" = whisper + caddy (eigener VPS), "whisper" = nur whisper (Plesk), leer = nur app + db
COMPOSE_PROFILES=prod
# Ports nur auf 127.0.0.1; ändern, falls auf dem Server belegt (z. B. Plesk mit eigenem PostgreSQL)
APP_PORT=3000
DB_PORT=5432
# Nur mit Caddy (Profil prod)
APP_DOMAIN=management.cdu-sf.de
ACME_EMAIL=                # Kontakt für Let's Encrypt
# Sicherung (scripts/backup.sh)
BACKUP_DIR=/var/backups/ov-tool
BACKUP_AGE_RECIPIENT=      # öffentlicher age-Schlüssel
BACKUP_KEEP_DAYS=30
BACKUP_REMOTE=             # z. B. rclone copy {file} storagebox:ov-backups

# Hintergrundjobs (pg-boss) – in der Entwicklung bei Bedarf abschalten
JOBS_ENABLED=true

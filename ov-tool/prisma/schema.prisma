// Datenmodell siehe SPEC.md Abschnitt 4. Modelle kommen paketweise hinzu.
// Bewusst kein Mitglieder-Modell (CLAUDE.md, Regel 1).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Setting {
  key   String @id
  value String
}

// ---------------------------------------------------------------------------
// Nutzer, Anmeldung, Audit (Paket 1.2)
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  SCHRIFTFUEHRER
  VORSTAND
  LESEZUGRIFF
  GAST
}

/// Stimmrecht im Vorstand, unabhängig von der App-Rolle (SPEC.md Abschnitt 2, LV-Satzung § 37)
enum VotingRight {
  STIMMBERECHTIGT
  BERATEND
  OHNE
}

model User {
  id                 String      @id @default(cuid())
  name               String
  /// immer kleingeschrieben gespeichert
  email              String      @unique
  emailVerified      DateTime?
  image              String?
  role               Role        @default(VORSTAND)
  /// z. B. „Ortsvorsitzender“, „Beisitzerin“ – steuert die Beschriftung in Anwesenheitslisten
  functionTitle      String      @default("")
  votingRight        VotingRight @default(STIMMBERECHTIGT)
  sortOrder          Int         @default(100)
  active             Boolean     @default(true)
  /// Gäste können ohne Login geführt werden (erhalten nur Mails)
  loginEnabled       Boolean     @default(true)
  signatureImagePath String?
  /// Telefonnummer (selbst gepflegt); in der Vorstandsliste nur mit Zustimmung sichtbar
  phone              String?
  showPhoneInBoard   Boolean     @default(false)
  /// Mitglied der CDU-Bezirksbeiräte (Seckenheim/Friedrichsfeld) – sieht BBR-Bereiche, z. B. BBR-Anliegen
  isBbr              Boolean     @default(false)
  icsToken           String      @unique @default(cuid())
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  accounts  Account[]
  sessions  Session[]
  auditLogs AuditLog[]
  links     Link[]     @relation("LinkCreatedBy")

  tasksAssigned       TaskAssignee[]
  tasksCreated        Task[]              @relation("TaskCreatedBy")
  taskComments        TaskComment[]
  meetingsCreated     Meeting[]           @relation("MeetingCreatedBy")
  attendances         Attendance[]
  agendaProposals     AgendaProposal[]
  proposalSupports    ProposalSupporter[]
  circulationsStarted Circulation[]       @relation("CirculationInitiatedBy")
  circulationsDecided Circulation[]       @relation("CirculationDeterminedBy")
  circulationVotes    CirculationVote[]
  transcriptsConsent  Transcript[]        @relation("TranscriptConsent")
  actionsCreated      Action[]            @relation("ActionCreatedBy")
  shiftSignups        ShiftSignup[]
  topicsResponsible   Topic[]             @relation("TopicResponsible")
  topicsCreated       Topic[]             @relation("TopicCreatedBy")
  topicEvents         TopicEvent[]
  attachments         Attachment[]
  templates           Template[]
  emailChangeTokens   EmailChangeToken[]
  marketingCreated    MarketingPost[] @relation("MarketingCreatedBy")
  marketingApproved   MarketingPost[] @relation("MarketingApprovedBy")
  inventoryCreated    InventoryItem[] @relation("InventoryCreatedBy")
  inventoryLoans      InventoryLoan[]

  @@index([active, sortOrder])
}

/// Bestätigung einer neuen E-Mail-Adresse: nur der Hash des Tokens wird gespeichert, einmal verwendbar.
model EmailChangeToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// immer kleingeschrieben
  newEmail  String
  /// SHA-256 des Tokens (hex)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Tabellen für Auth.js (@auth/prisma-adapter)
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model AuditLog {
  id         String   @id @default(cuid())
  /// null bei Systemaktionen (Jobs) oder Aktionen ohne Login (Zusage-Link)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  diff       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Link-Hub (Paket 1.3) – keine Zugangsdaten speichern (CLAUDE.md Regel 5)
// ---------------------------------------------------------------------------

enum LinkCategory {
  ZUSAMMENARBEIT
  PARTEI
  OV_WEBSEITE
  SOCIAL_MEDIA
  VERWALTUNG
  PRESSE
  SONSTIGES
}

model Link {
  id            String       @id @default(cuid())
  title         String
  url           String
  category      LinkCategory @default(SONSTIGES)
  description   String       @default("")
  /// „Zugang über …“ – Hinweis, wer Zugang hat, nie das Passwort selbst
  accessNote    String       @default("")
  /// Redaktionsnotiz für Social-Media-Kanäle (wer betreut, Posting-Rhythmus)
  editorialNote String       @default("")
  /// nur für Bezirksbeiräte sichtbar (User.isBbr)
  bbrOnly       Boolean      @default(false)
  position      Int          @default(0)
  createdById   String?
  createdBy     User?        @relation("LinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([category, position])
}

// ---------------------------------------------------------------------------
// Aufgaben (Paket 1.4)
// ---------------------------------------------------------------------------

enum TaskStatus {
  OFFEN
  IN_ARBEIT
  ERLEDIGT
}

enum TaskPriority {
  NIEDRIG
  NORMAL
  HOCH
}

/// Verantwortlich als Gruppe statt (oder zusätzlich zu) einzelnen Personen
enum AssigneeGroup {
  KEINE
  VORSTAND
  ALLE
}

model Task {
  id                String        @id @default(cuid())
  title             String
  description       String        @default("")
  assigneeGroup     AssigneeGroup @default(KEINE)
  /// Frist als Datum (Berliner Mitternacht) – nur dann gibt es Erinnerungen
  dueDate           DateTime?
  /// Frist als Freitext, z. B. „laufend“
  dueText           String        @default("")
  status            TaskStatus    @default(OFFEN)
  priority          TaskPriority?
  completedAt       DateTime?
  remindedBeforeAt  DateTime?
  remindedOverdueAt DateTime?

  meetingId    String?
  meeting      Meeting?    @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  agendaItemId String?
  agendaItem   AgendaItem? @relation(fields: [agendaItemId], references: [id], onDelete: SetNull)
  resolutionId String?
  resolution   Resolution? @relation(fields: [resolutionId], references: [id], onDelete: SetNull)
  actionId     String?
  action       Action?     @relation(fields: [actionId], references: [id], onDelete: SetNull)
  topicId      String?
  topic        Topic?      @relation(fields: [topicId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?    @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignees TaskAssignee[]
  comments  TaskComment[]

  @@index([status, dueDate])
  @@index([meetingId])
}

model TaskAssignee {
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  text      String
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

// ---------------------------------------------------------------------------
// Sitzungen, Tagesordnung, Zu-/Absagen (Paket 1.5)
// ---------------------------------------------------------------------------

enum MeetingType {
  VORSTANDSSITZUNG
  ERWEITERTE_VORSTANDSSITZUNG
  KLAUSURTAGUNG
  SONSTIGE
}

enum MeetingFormat {
  PRAESENZ
  DIGITAL
  HYBRID
}

enum MeetingStatus {
  GEPLANT
  EINGELADEN
  DURCHGEFUEHRT
  AUFGEHOBEN
  ABGESAGT
}

model Meeting {
  id                        String        @id @default(cuid())
  type                      MeetingType   @default(VORSTANDSSITZUNG)
  format                    MeetingFormat @default(PRAESENZ)
  title                     String        @default("")
  /// einziges Feld für Datum und Uhrzeit (Betreff, Brief, Mail, Protokoll)
  startsAt                  DateTime
  endsAt                    DateTime?
  location                  String        @default("")
  onlineUrl                 String        @default("")
  status                    MeetingStatus @default(GEPLANT)
  responseDeadline          DateTime?
  invitationSentAt          DateTime?
  invitationTemplateVersion Int?
  /// verkürzte Ladungsfrist (LV § 50 Abs. 3) – Begründung erscheint im Protokoll
  urgent                    Boolean       @default(false)
  urgencyReason             String        @default("")
  /// neue Sitzung nach Aufhebung wegen Beschlussunfähigkeit (LV § 52 Abs. 3)
  isRepeatAfterNoQuorum     Boolean       @default(false)
  previousMeetingId         String?       @unique
  previousMeeting           Meeting?      @relation("RepeatMeeting", fields: [previousMeetingId], references: [id], onDelete: SetNull)
  repeatMeeting             Meeting?      @relation("RepeatMeeting")
  openedAt                  DateTime?
  closedAt                  DateTime?
  interruptionNote          String        @default("")
  /// Sitzungsleitung (Freitext, kann wechseln)
  chairNote                 String        @default("")
  /// Feststellung der Beschlussfähigkeit vor TOP 1 (Statut § 40 Abs. 2)
  quorumDeterminedAt        DateTime?
  quorumDeterminedBy        String        @default("")
  quorumPresent             Int?
  quorumEligible            Int?
  quorumReached             Boolean?
  cancelReason              String        @default("")
  cancelledAt               DateTime?
  /// weitere Anwesende ohne Nutzerkonto (Freitext)
  extraAttendees            String        @default("")
  rsvpReminderSentAt        DateTime?
  invitationWarningSentAt   DateTime?
  createdById               String?
  createdBy                 User?         @relation("MeetingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  agendaItems         AgendaItem[]
  attendances         Attendance[]
  minutes             Minutes[]        @relation("MinutesMeeting")
  minutesApprovedHere Minutes[]        @relation("MinutesApprovedAt")
  resolutions         Resolution[]
  tasks               Task[]
  transcripts         Transcript[]
  proposals           AgendaProposal[]
  circulationsDecided Circulation[]    @relation("CirculationDecidedIn")

  @@index([startsAt])
  @@index([status])
}

enum AgendaItemStatus {
  OFFEN
  BEHANDELT
  ABGESETZT
  VERTAGT
}

/// Sonder-TOPs, die das Tool selbst pflegt
enum AgendaItemKind {
  NORMAL
  PROTOKOLLGENEHMIGUNG
  AUFGABENBERICHT
  TERMINE
  SONSTIGES
}

model AgendaItem {
  id                 String           @id @default(cuid())
  meetingId          String
  meeting            Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  parentId           String?
  parent             AgendaItem?      @relation("AgendaChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children           AgendaItem[]     @relation("AgendaChildren")
  position           Int
  title              String
  description        String           @default("")
  status             AgendaItemStatus @default(OFFEN)
  kind               AgendaItemKind   @default(NORMAL)
  topicId            String?
  topic              Topic?           @relation(fields: [topicId], references: [id], onDelete: SetNull)
  minutesToApproveId String?
  minutesToApprove   Minutes?         @relation("ApprovalItem", fields: [minutesToApproveId], references: [id], onDelete: SetNull)
  proposalId         String?          @unique
  proposal           AgendaProposal?  @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  carriedOverFromId  String?
  carriedOverFrom    AgendaItem?      @relation("CarryOver", fields: [carriedOverFromId], references: [id], onDelete: SetNull)
  carriedOverTo      AgendaItem[]     @relation("CarryOver")
  /// abgesetzter/vertagter TOP soll nicht mehr als Vorschlag erscheinen
  carryOverDismissed Boolean          @default(false)
  createdAt          DateTime         @default(now())

  tasks       Task[]
  resolutions Resolution[]
  sections    MinutesSection[]

  @@index([meetingId, parentId, position])
}

enum ProposalStatus {
  OFFEN
  UEBERNOMMEN
  VERWORFEN
}

/// TO-Vorschlag eines Vorstandsmitglieds; optional als Antrag auf Einberufung (LV § 31 Abs. 3)
model AgendaProposal {
  id               String              @id @default(cuid())
  title            String
  description      String              @default("")
  proposedById     String?
  proposedBy       User?               @relation(fields: [proposedById], references: [id], onDelete: SetNull)
  /// Wunsch-Sitzung; leer = nächste Sitzung
  meetingId        String?
  meeting          Meeting?            @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  status           ProposalStatus      @default(OFFEN)
  isConveneRequest Boolean             @default(false)
  adminNotifiedAt  DateTime?
  decisionNote     String              @default("")
  createdAt        DateTime            @default(now())
  supporters       ProposalSupporter[]
  agendaItem       AgendaItem?

  @@index([status])
}

model ProposalSupporter {
  proposalId String
  proposal   AgendaProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@id([proposalId, userId])
}

enum RsvpResponse {
  OFFEN
  ZUGESAGT
  VIELLEICHT
  ABGESAGT
}

enum Presence {
  ANWESEND
  ANWESEND_DIGITAL
  ENTSCHULDIGT
  NICHT_ANWESEND
}

model Attendance {
  id               String       @id @default(cuid())
  meetingId        String
  meeting          Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  response         RsvpResponse @default(OFFEN)
  respondedAt      DateTime?
  /// Einladung an diese Person versendet (Nachversand an neu Hinzugekommene)
  invitedAt        DateTime?
  /// persönlicher Link in der Einladungsmail (funktioniert ohne Login)
  responseToken    String       @unique
  presence         Presence?
  arrivedAt        DateTime?
  leftAt           DateTime?
  note             String       @default("")
  /// Stand zum Zeitpunkt der Sitzung, damit alte Protokolle stabil bleiben
  nameSnapshot     String
  functionSnapshot String       @default("")
  votingSnapshot   VotingRight
  sortSnapshot     Int          @default(100)

  @@unique([meetingId, userId])
}

// ---------------------------------------------------------------------------
// Protokolle, Beschlüsse, Umlaufverfahren (Paket 1.7)
// ---------------------------------------------------------------------------

enum MinutesStatus {
  ENTWURF
  VERSENDET
  GENEHMIGT
}

enum ApprovalMode {
  SITZUNG
  UMLAUF
}

model Minutes {
  id                  String        @id @default(cuid())
  meetingId           String
  meeting             Meeting       @relation("MinutesMeeting", fields: [meetingId], references: [id], onDelete: Cascade)
  status              MinutesStatus @default(ENTWURF)
  version             Int           @default(1)
  /// nur die aktuelle Version wird bearbeitet/angezeigt; ältere bleiben gesperrt erhalten
  isCurrent           Boolean       @default(true)
  previousVersionId   String?       @unique
  previousVersion     Minutes?      @relation("MinutesVersions", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersion         Minutes?      @relation("MinutesVersions")
  changeNote          String        @default("")
  recorderName        String        @default("")
  /// { eroeffnung, wiedereroeffnung, tagesordnung, letztesProtokoll }
  formalities         Json          @default("{}")
  /// [{ name, funktion }]
  signers             Json          @default("[]")
  approvalMode        ApprovalMode?
  approvedAtMeetingId String?
  approvedAtMeeting   Meeting?      @relation("MinutesApprovedAt", fields: [approvedAtMeetingId], references: [id], onDelete: SetNull)
  sentAt              DateTime?
  approvedAt          DateTime?
  sentToOfficeAt      DateTime?
  templateVersion     Int?
  aiUncertainties     Json?
  aiMisc              Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  sections      MinutesSection[]
  approvalItems AgendaItem[]     @relation("ApprovalItem")
  circulations  Circulation[]

  @@index([meetingId, isCurrent])
}

enum OutcomeType {
  BESCHLUSS
  ERGEBNIS
}

model MinutesSection {
  id           String       @id @default(cuid())
  minutesId    String
  minutes      Minutes      @relation(fields: [minutesId], references: [id], onDelete: Cascade)
  agendaItemId String?
  agendaItem   AgendaItem?  @relation(fields: [agendaItemId], references: [id], onDelete: SetNull)
  /// [{ text, unterpunkte: string[] }]
  points       Json         @default("[]")
  outcomeType  OutcomeType?
  outcomeText  String       @default("")

  @@unique([minutesId, agendaItemId])
}

enum ResolutionResult {
  ANGENOMMEN_EINSTIMMIG
  ANGENOMMEN_MEHRHEITLICH
  ABGELEHNT
  FESTGESTELLT
  ABGESETZT
  VERTAGT
  KENNTNISNAHME
}

model Resolution {
  id            String           @id @default(cuid())
  meetingId     String?
  meeting       Meeting?         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  agendaItemId  String?
  agendaItem    AgendaItem?      @relation(fields: [agendaItemId], references: [id], onDelete: SetNull)
  circulationId String?          @unique
  circulation   Circulation?     @relation(fields: [circulationId], references: [id], onDelete: SetNull)
  /// laufende Nummer je Jahr, z. B. 2026-07
  number        String           @unique
  subject       String
  kind          OutcomeType
  resultType    ResolutionResult
  votesYes      Int?
  votesNo       Int?
  votesAbstain  Int?
  createdAt     DateTime         @default(now())

  tasks Task[]

  @@index([meetingId])
}

enum CirculationStatus {
  LAUFEND
  ANGENOMMEN
  ABGELEHNT
  UNZULAESSIG
  ABGEBROCHEN
}

enum CirculationVoteValue {
  JA
  NEIN
  ENTHALTUNG
  WIDERSPRUCH
}

/// Umlaufbeschluss (Statut § 42 Abs. 3)
model Circulation {
  id                  String            @id @default(cuid())
  /// U-2026-01
  number              String            @unique
  subject             String
  text                String
  reason              String            @default("")
  minutesId           String?
  minutes             Minutes?          @relation(fields: [minutesId], references: [id], onDelete: SetNull)
  initiatedById       String?
  initiatedBy         User?             @relation("CirculationInitiatedBy", fields: [initiatedById], references: [id], onDelete: SetNull)
  initiatedAt         DateTime          @default(now())
  deadline            DateTime
  decidedInMeetingId  String?
  decidedInMeeting    Meeting?          @relation("CirculationDecidedIn", fields: [decidedInMeetingId], references: [id], onDelete: SetNull)
  status              CirculationStatus @default(LAUFEND)
  eligibleCount       Int
  determinedById      String?
  determinedBy        User?             @relation("CirculationDeterminedBy", fields: [determinedById], references: [id], onDelete: SetNull)
  determinedAt        DateTime?
  announcedAt         DateTime?
  /// Admin wurde über den Fristablauf informiert
  deadlineNotifiedAt  DateTime?
  resultText          String            @default("")
  /// in welcher Sitzung darüber berichtet wurde
  reportedInMeetingId String?
  votes               CirculationVote[]
  resolution          Resolution?

  @@index([status])
}

model CirculationVote {
  id            String                @id @default(cuid())
  circulationId String
  circulation   Circulation           @relation(fields: [circulationId], references: [id], onDelete: Cascade)
  userId        String
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  token         String                @unique
  vote          CirculationVoteValue?
  comment       String                @default("")
  votedAt       DateTime?

  @@unique([circulationId, userId])
}

// ---------------------------------------------------------------------------
// Transkripte (Paket 2.2)
// ---------------------------------------------------------------------------

enum TranscriptSource {
  HANDY
  PLAUD
  TEAMS
  ZOOM
  SONSTIGE
}

enum TranscriptStatus {
  HOCHGELADEN
  TRANSKRIPTION
  TRANSKRIBIERT
  ENTWURF_LAEUFT
  ENTWURF_FERTIG
  FEHLER
}

model Transcript {
  id                   String           @id @default(cuid())
  meetingId            String
  meeting              Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  source               TranscriptSource
  originalName         String
  mimeType             String           @default("")
  /// Audiodatei bis zur Transkription; danach gelöscht
  filePath             String?
  text                 String?
  status               TranscriptStatus @default(HOCHGELADEN)
  progress             Int              @default(0)
  error                String           @default("")
  /// Pflicht: „Alle Anwesenden haben der Aufnahme zugestimmt.“
  consentConfirmedById String?
  consentConfirmedBy   User?            @relation("TranscriptConsent", fields: [consentConfirmedById], references: [id], onDelete: SetNull)
  consentConfirmedAt   DateTime
  audioDeletedAt       DateTime?
  textDeletedAt        DateTime?
  deleteAfter          DateTime?
  draft                Json?
  draftCreatedAt       DateTime?
  draftAppliedAt       DateTime?
  createdAt            DateTime         @default(now())

  @@index([status])
}

// ---------------------------------------------------------------------------
// Aktionen und Helferschichten (Paket 2.3)
// ---------------------------------------------------------------------------

enum ActionType {
  INFOSTAND
  PLAKATAKTION
  VERANSTALTUNG
  BUERGERGESPRAECH
  SONSTIGES
}

enum ActionStatus {
  GEPLANT
  BESTAETIGT
  DURCHGEFUEHRT
  ABGESAGT
}

model Action {
  id             String       @id @default(cuid())
  type           ActionType   @default(INFOSTAND)
  title          String
  startsAt       DateTime
  endsAt         DateTime?
  location       String       @default("")
  description    String       @default("")
  partners       String       @default("")
  status         ActionStatus @default(GEPLANT)
  followUpNote   String       @default("")
  helpCallSentAt DateTime?
  createdById    String?
  createdBy      User?        @relation("ActionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  shifts Shift[]
  tasks  Task[]

  @@index([startsAt])
}

model Shift {
  id       String        @id @default(cuid())
  actionId String
  action   Action        @relation(fields: [actionId], references: [id], onDelete: Cascade)
  startsAt DateTime
  endsAt   DateTime
  needed   Int           @default(2)
  note     String        @default("")
  signups  ShiftSignup[]

  @@index([actionId, startsAt])
}

model ShiftSignup {
  id        String   @id @default(cuid())
  shiftId   String
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([shiftId, userId])
}

// ---------------------------------------------------------------------------
// Stadtteil-Themen und Bürgeranliegen (Paket 3.1/3.2)
// ---------------------------------------------------------------------------

enum District {
  SECKENHEIM
  FRIEDRICHSFELD
  BEIDE
}

enum TopicStatus {
  NEU
  IN_BEARBEITUNG
  BEI_STADTRAETEN
  IM_BEZIRKSBEIRAT
  PRESSE
  ERLEDIGT
  ZURUECKGESTELLT
}

enum TopicEventType {
  NOTIZ
  STATUS
  ANFRAGE
  ANTWORT_VERWALTUNG
  PRESSE
  SITZUNG
  SONSTIGES
}

model Topic {
  id                 String      @id @default(cuid())
  title              String
  description        String      @default("")
  /// anpassbar (Einstellung „topic.categories“)
  category           String      @default("Sonstiges")
  district           District    @default(BEIDE)
  status             TopicStatus @default(NEU)
  responsibleId      String?
  responsible        User?       @relation("TopicResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  forNextMeeting     Boolean     @default(false)
  isCitizenConcern   Boolean     @default(false)
  /// verschlüsselt (AES-256-GCM, ENCRYPTION_KEY); nur mit Einwilligung
  citizenContact     String?
  citizenConsentAt   DateTime?
  contactDeleteAfter DateTime?
  contactDeletedAt   DateTime?
  resolvedAt         DateTime?
  createdById        String?
  createdBy          User?       @relation("TopicCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  events      TopicEvent[]
  tasks       Task[]
  agendaItems AgendaItem[]

  @@index([status])
  @@index([updatedAt])
}

model TopicEvent {
  id        String         @id @default(cuid())
  topicId   String
  topic     Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  type      TopicEventType @default(NOTIZ)
  text      String
  date      DateTime
  authorId  String?
  author    User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())

  @@index([topicId, date])
}

// ---------------------------------------------------------------------------
// Anhänge und Vorlagen
// ---------------------------------------------------------------------------

model Attachment {
  id           String   @id @default(cuid())
  /// "Action" | "Topic" | "TopicEvent" | "Task" | "Meeting"
  ownerType    String
  ownerId      String
  filePath     String
  fileName     String
  mimeType     String
  size         Int
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  /// Sitzungsunterlagen: mit der Einladung versenden und auf der Rückmeldeseite anbieten
  inInvitation Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([ownerType, ownerId])
}

/// Versionierte Vorlagen (Paket 1.6); je Schlüssel ist genau eine Version aktiv
model Template {
  id          String   @id @default(cuid())
  key         String
  name        String
  body        String
  version     Int
  active      Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([key, version])
  @@index([key, active])
}

// ---------------------------------------------------------------------------
// Marketing: Social-Media-Beiträge und Blogartikel (KI-Entwurf → Freigabe → Veröffentlichung)
// ---------------------------------------------------------------------------

enum MarketingKind {
  SOCIAL
  BLOG
}

enum MarketingStatus {
  ENTWURF
  FREIGEGEBEN
  VEROEFFENTLICHT
}

model MarketingPost {
  id           String          @id @default(cuid())
  kind         MarketingKind
  status       MarketingStatus @default(ENTWURF)
  title        String          @default("")
  /// Beitragstext; bei Blogartikeln einfache Absätze (Leerzeile = neuer Absatz), Zwischenüberschriften mit "## "
  body         String          @default("")
  /// Stichpunkte/Anlass, aus denen der Entwurf entstand
  brief        String          @default("")
  /// Kanäle für Social-Beiträge, z. B. facebook, instagram, whatsapp, newsletter
  channels     String[]
  hashtags     String          @default("")
  /// Blog: Zielseite (SF = cdu-sf.de, BBR = bbr.cdu-sf.de)
  site         String?
  plannedFor   DateTime?
  wpPostId     Int?
  wpLink       String?
  wpStatus     String?
  publishedAt  DateTime?
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?           @relation("MarketingApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?           @relation("MarketingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Inventar: Materialien des OV (Schirm, Stehtisch, Pavillon …) mit Barcode OVMASF01234.20
// ---------------------------------------------------------------------------

model InventoryItem {
  id           String          @id @default(cuid())
  /// laufende Nummer (fünfstellig im Code)
  number       Int             @unique
  /// Anschaffungsjahr (vierstellig; im Code die letzten zwei Ziffern)
  acquiredYear Int
  /// Barcode-Inhalt, z. B. OVMASF01234.20 – unveränderlich nach Vergabe
  code         String          @unique
  name         String
  description  String          @default("")
  category     String          @default("")
  location     String          @default("")
  quantity     Int             @default(1)
  condition    String          @default("gut")
  photoPath    String?
  /// aktuell verliehen an (leer = im Lager); Verlauf in InventoryLoan
  lentTo       String?
  lentAt       DateTime?
  lentDueAt    DateTime?
  notes        String          @default("")
  /// ausgemustert (bleibt für die Historie erhalten, Nummer wird nicht neu vergeben)
  retiredAt    DateTime?
  createdById  String?
  createdBy    User?           @relation("InventoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  loans        InventoryLoan[]

  @@index([retiredAt, name])
}

model InventoryLoan {
  id          String        @id @default(cuid())
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  borrower    String
  lentAt      DateTime      @default(now())
  dueAt       DateTime?
  returnedAt  DateTime?
  note        String        @default("")
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([itemId, lentAt])
}
